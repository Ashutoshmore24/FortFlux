# ──────────────────────────────────────────────────
# FortFlux Backend — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────

NODE_ENV="development"

PORT=6000

MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=FortFlux"

JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="4d"
